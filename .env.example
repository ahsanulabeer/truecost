# Anthropic API key — used for the cost-analysis prompt.
# https://console.anthropic.com/settings/keys
# NOTE: Vite inlines VITE_* vars into the browser bundle. For a public deploy,
# move this call behind a backend proxy so the key isn't shipped to the client.
VITE_ANTHROPIC_API_KEY=sk-ant-your-key-here

# RentCast API key — used to fetch real listing/AVM data.
# https://app.rentcast.io/app/api
VITE_RENTCAST_API_KEY=your-rentcast-key-here
