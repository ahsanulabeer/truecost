# These keys are read by the Netlify Functions in netlify/functions/, NOT by
# the browser. They must NOT have a VITE_ prefix — Vite would inline anything
# prefixed VITE_ into the client bundle, which is what the proxy is preventing.
#
# Local dev: install netlify-cli (npm i -g netlify-cli) and run `netlify dev`
# instead of `npm run dev` so the functions are available at /api/*.
#
# Production: set these as environment variables in the Netlify dashboard
# under Site settings → Environment variables.

# Anthropic API key — used by netlify/functions/analyze.js
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# RentCast API key — used by netlify/functions/rentcast.js
# https://app.rentcast.io/app/api
RENTCAST_API_KEY=your-rentcast-key-here
